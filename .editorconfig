root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# shfmt reads these.
[*.sh]
binary_next_line = true
switch_case_indent = true

[bin/onbehalf]
binary_next_line = true
switch_case_indent = true

[Makefile]
indent_style = tab
