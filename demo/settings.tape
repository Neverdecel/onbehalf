# Settings for all casts. Each tape starts with:
#   Source "/demo/settings.tape"
#   Source "/demo/prompt.tape"
# A tape can change a setting between the two lines.
Set Shell bash
Set FontSize 22
Set Width 1280
Set Height 760
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms
Set CursorBlink false
Set WindowBar Colorful
Set WaitTimeout 120s
