# Secrets of the telemetry backend. Copy to .env, set mode 600, keep it root
# only. No user may read this file. Make each password with:
#   openssl rand -hex 24

# The gid of the group otelcol-contrib on the host. Make the group with:
#   groupadd --system otelcol-contrib && getent group otelcol-contrib | cut -d: -f3
OTELCOL_GID=

POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=

# Langfuse secrets. SALT and NEXTAUTH_SECRET: openssl rand -hex 24.
# ENCRYPTION_KEY: openssl rand -hex 32 (64 hex characters).
SALT=
NEXTAUTH_SECRET=
ENCRYPTION_KEY=

# The API keys of the Langfuse project. The Collector sends with them.
#   echo "pk-lf-$(openssl rand -hex 16)"   and   echo "sk-lf-$(openssl rand -hex 16)"
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# The first Langfuse account. Sign-up is off, so this account adds the others.
LANGFUSE_ADMIN_EMAIL=ops@example.com
LANGFUSE_ADMIN_PASSWORD=

# The address in the browser. With an SSH tunnel to port 3000, keep the default.
NEXTAUTH_URL=http://localhost:3000
