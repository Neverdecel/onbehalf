# Secrets of the model gateway. Copy to .env, set mode 600, keep it root only.
# No user may read this file.

# Admin key of the gateway. onbehalf init asks for it. Make one with:
#   echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=

POSTGRES_PASSWORD=

# Model provider keys (the team's model credentials).
AZURE_API_KEY=
AZURE_AI_API_KEY=
